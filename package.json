{
  "name": "siuuu",
  "type": "module",
  "version": "1.1.0",
  "description": "A CLI that compresses images (PNG / JPEG / WebP) with WebAssembly codecs.",
  "author": "Author Name <author.name@mail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/WBBB0730/siuuu#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/WBBB0730/siuuu.git"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./worker": "./dist/worker.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "siuuu": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "play": "tsdown && tsx scripts/play.ts",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "bumpp": "^11.1.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "i18next": "^26.3.0",
    "imagequant": "^0.1.2",
    "picocolors": "^1.1.1"
  }
}
